# Database Configuration
DB_HOST=localhost
DB_NAME=order_processing
DB_USER=root
DB_PASS=

# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
# Production: use APP_URL=https://oms.jldminerals.com so session cookie works over HTTPS
# Or set SESSION_SECURE=1 to force secure cookie
SESSION_SECRET=your-secret-key-here
APP_TIMEZONE=Asia/Kolkata

# Security
CSRF_SECRET=your-csrf-secret-here
# HTTP response security headers
SECURITY_HEADERS_ENABLED=1
# Optional custom CSP override (if empty, app uses built-in compatible default)
# SECURITY_CSP=
# HSTS settings (applied only over HTTPS requests)
# SECURITY_HSTS_MAX_AGE=31536000
# SECURITY_HSTS_INCLUDE_SUBDOMAINS=1
# SECURITY_HSTS_PRELOAD=0
# Global rate-limiting (set 0 to disable)
RATE_LIMIT_ENABLED=1
# Login throttling
# RATE_LIMIT_LOGIN_MAX=8
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
# Webhook throttling
# RATE_LIMIT_GPS_WEBHOOK_MAX=300
# RATE_LIMIT_GPS_WEBHOOK_WINDOW_SECONDS=60
# RATE_LIMIT_FUEL_WEBHOOK_MAX=300
# RATE_LIMIT_FUEL_WEBHOOK_WINDOW_SECONDS=60
# RATE_LIMIT_GPS_BATCH_MAX=120
# RATE_LIMIT_GPS_BATCH_WINDOW_SECONDS=60
# CSV import throttling
# RATE_LIMIT_RECEIVABLE_IMPORT_MAX=20
# RATE_LIMIT_RECEIVABLE_IMPORT_WINDOW_SECONDS=300
# RATE_LIMIT_PARTIES_IMPORT_MAX=20
# RATE_LIMIT_PARTIES_IMPORT_WINDOW_SECONDS=300

# GPS / WheelsEye (optional: for webhook auth and pull API)
# GPS_FUEL_API_KEY=optional-key-for-webhook-auth
# Optional HMAC webhook verification (if provider sends signature headers)
# GPS_FUEL_WEBHOOK_SECRET=shared-webhook-secret
# GPS_FUEL_WEBHOOK_TOLERANCE_SECONDS=300
# GPS_FUEL_WEBHOOK_MAX_BYTES=1048576
# WheelsEye pull API (current location)
# WHEELSEYE_API_BASE_URL=https://api.wheelseye.com
# WHEELSEYE_ACCESS_TOKEN=your-access-token-from-vendor
# Optional: secret for cron auto-sync (GET /api/tracking/sync?key=this-secret) - no login needed
# TRACKING_SYNC_KEY=

# Optional: Mapbox access token for Live Tracking (newer satellite + detailed streets). Get free token at https://account.mapbox.com/
# MAPBOX_ACCESS_TOKEN=

# Email Configuration (optional)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com



