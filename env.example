# Database Configuration
DB_HOST=localhost
DB_NAME=order_processing
DB_USER=root
DB_PASS=

# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
# Production: use APP_URL=https://oms.jldminerals.com so session cookie works over HTTPS
# Or set SESSION_SECURE=1 to force secure cookie
SESSION_SECRET=your-secret-key-here
APP_TIMEZONE=Asia/Kolkata

# Security
CSRF_SECRET=your-csrf-secret-here
# HTTP response security headers (recommended: keep enabled in production)
SECURITY_HEADERS_ENABLED=1
# Leave SECURITY_CSP empty to use the built-in default (supports Leaflet map tiles).
# Do NOT paste a long CSP here unless you know the full policy — broken CSP breaks Geofences maps.
# SECURITY_CSP=
# HSTS settings (applied only over HTTPS requests)
# SECURITY_HSTS_MAX_AGE=31536000
# SECURITY_HSTS_INCLUDE_SUBDOMAINS=1
# SECURITY_HSTS_PRELOAD=0
# Global rate-limiting (set 0 to disable)
RATE_LIMIT_ENABLED=1
# Login throttling
# RATE_LIMIT_LOGIN_MAX=8
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
# Webhook throttling
# RATE_LIMIT_GPS_WEBHOOK_MAX=300
# RATE_LIMIT_GPS_WEBHOOK_WINDOW_SECONDS=60
# RATE_LIMIT_FUEL_WEBHOOK_MAX=300
# RATE_LIMIT_FUEL_WEBHOOK_WINDOW_SECONDS=60
# RATE_LIMIT_GPS_BATCH_MAX=120
# RATE_LIMIT_GPS_BATCH_WINDOW_SECONDS=60
# CSV import throttling
# RATE_LIMIT_RECEIVABLE_IMPORT_MAX=20
# RATE_LIMIT_RECEIVABLE_IMPORT_WINDOW_SECONDS=300
# RATE_LIMIT_PARTIES_IMPORT_MAX=20
# RATE_LIMIT_PARTIES_IMPORT_WINDOW_SECONDS=300

# GPS / WheelsEye (optional: for webhook auth and pull API)
# GPS_FUEL_API_KEY=optional-key-for-webhook-auth
# Optional HMAC webhook verification (if provider sends signature headers)
# GPS_FUEL_WEBHOOK_SECRET=shared-webhook-secret
# GPS_FUEL_WEBHOOK_TOLERANCE_SECONDS=300
# GPS_FUEL_WEBHOOK_MAX_BYTES=1048576
# WheelsEye pull API (current location)
# WHEELSEYE_API_BASE_URL=https://api.wheelseye.com
# WHEELSEYE_ACCESS_TOKEN=your-access-token-from-vendor
# Optional: historical trips pull API paths (used by /api/tracking/sync-yesterday-trips)
# WHEELSEYE_ITINERARY_PATH=/getItinerary
# WHEELSEYE_PATH_DETAIL_PATH=/getPathDetail
# Optional: polyline precision for followedPolyLine decoding (default 5)
# WHEELSEYE_POLYLINE_PRECISION=5
# Optional: secret for URL-based cron — NOT recommended (uses PHP-FPM; can cause 504s).
# Use CLI systemd instead: sudo bash scripts/configure-wheelseye-production.sh
# TRACKING_SYNC_KEY=
# Production: disable HTTP pull sync (logged-in manual Sync button still works)
# WHEELSEYE_ALLOW_HTTP_SYNC=0
# Disable WheelsEye pull on Live Tracking auto-refresh API (default off)
# WHEELSEYE_ALLOW_LIVE_PAGE_SYNC=0
#
# Cron/sync: each poll saves a GPS row and runs trip detection even when WheelsEye
# returns the same coordinates (re-stamped with poll time). Webhook path unchanged.
#
# Server sync (recommended): webhook primary + CLI systemd backup every 2 minutes:
#   sudo bash scripts/configure-wheelseye-production.sh
# Or manually:
#   WHEELSEYE_SYNC_INTERVAL_SECONDS=120 sudo bash scripts/install-wheelseye-systemd.sh
# Uninstall loop: SYSTEMD_UNINSTALL=1 sudo bash scripts/install-wheelseye-systemd.sh
#
# Legacy cron (30s CLI only — avoid if systemd is installed):
#   sudo bash scripts/install-wheelseye-cron.sh
# Requires WHEELSEYE_ACCESS_TOKEN above. Logs: storage/logs/wheelseye-cron.log

# Optional: Mapbox access token for Live Tracking (newer satellite + detailed streets). Get free token at https://account.mapbox.com/
# MAPBOX_ACCESS_TOKEN=

# Geofence boundary tolerance (meters) to reduce "inside/outside" flapping when geofences
# are very close or GPS points jitter slightly near the border.
# If your stockpiles/pit geofences touch or overlap tightly, you may need to increase these.
# GEOFENCE_CIRCLE_EDGE_TOLERANCE_METERS=3.0
# GEOFENCE_POLYGON_EDGE_TOLERANCE_METERS=3.0

# Email Configuration (optional)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com

# Reminders runner (offline PC agent)
# Generate a random secret and set on server + runner PC. Keep it private.
# REMINDERS_RUNNER_KEY=change-me

# Payment reminders (BusyPayBot) – required on the server that runs the OMS app
# Local Windows (accountant PC with BusyPayBot installed):
# REMINDERS_SCRIPT_JLD_MINERALS="C:/BusyPayBot/JLD Minerals Private Limited/main.py"
# REMINDERS_SCRIPT_JAICHAND="C:/BusyPayBot/Jaichand Lal Daga/main.py"
# PYTHON_PATH=python
# Linux server (oms.jldminerals.com) – copy BusyPayBot into these folders first:
# REMINDERS_SCRIPT_JLD_MINERALS=/var/www/oms/busypaybot/jld-minerals/main.py
# REMINDERS_SCRIPT_JAICHAND=/var/www/oms/busypaybot/jaichand/main.py
# Or outside the app: /var/www/busypaybot/jld-minerals/main.py
# PYTHON_PATH=python3
# Fallback if only one script: REMINDERS_SCRIPT=scripts/send_reminders.py

# Busy invoice → dispatch import (webhook from Busy or CSV upload on /dispatch)
# BUSY_WEBHOOK_API_KEY=change-me
# BUSY_WEBHOOK_SECRET=
# BUSY_WEBHOOK_ALLOWED_IPS=127.0.0.1,::1


